# ── Appearance ────────────────────────────────────────────────────────────────
theme = Catppuccin Mocha
font-family = MesloLGS Nerd Font Mono
font-size = 14
font-thicken = true

window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

# ── Cursor ────────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Scrollback ────────────────────────────────────────────────────────────────
scrollback-limit = 10000
mouse-hide-while-typing = true

# ── Shell integration ─────────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Tabs & windows ────────────────────────────────────────────────────────────
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = true

# ── Keybindings ───────────────────────────────────────────────────────────────
# Tabs
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface
keybind = ctrl+shift+right_bracket=next_tab
keybind = ctrl+shift+left_bracket=previous_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5

# Splits
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+equal=equalize_splits

# Navigate splits
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down

# Font size
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Misc
keybind = ctrl+k=clear_screen
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
